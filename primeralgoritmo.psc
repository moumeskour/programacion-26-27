Algoritmo Saludar
	
	Definir nombre_alumno Como Caracter;
	Definir edad_alumno Como Entero;
	
	
	Escribir "¿Como te llamas?";
	Leer nombre_alumno;
	Escribir "Tu nombre es " nombre_alumno;
	
	Escribir "¿Que edad tienes?";
	Leer edad_alumno;
	Escribir "Tienes " edad_alumno " años";
	
	Escribir  "Te llamas " nombre_alumno " y tienes " edad_alumno " años";
	
	
FinAlgoritmo
