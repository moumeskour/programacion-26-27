Algoritmo sin_titulo
	
	Definir a, b Como Entero;
	
	
	Escribir "Cuanto vale a? ";
	Leer a;
	
	Escribir "Cuanto vale b? ";
	Leer b;
	
	

	Si a>b Entonces
	Escribir "A es mas mayor que B";
SiNo
	Si a=b Entonces
		Escribir "A y B son iguales";
	SiNo
		Escribir "B es mas mayor que A";
	Fin Si
Fin Si



	
FinAlgoritmo
