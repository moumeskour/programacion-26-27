Algoritmo sin_titulo
	
		Definir bach Como Caracter;
		Definir prueba Como Caracter;
		
		Escribir "Tienes el titulo de Bachillerato? ";
		Leer bach;
		
		Si bach == "si" Entonces
			Escribir "Puedes entrar al Grado Superior";
		SiNo
			Escribir "Has aprobado la prueba de acceso? ";
			Leer prueba;
			
			Si prueba == "si" Entonces
				Escribir "Puedes entrar al grado superior";
			SiNo
				Escribir "No puedes entrar al grado superior";
			FinSi
		FinSi
		
	
FinAlgoritmo
