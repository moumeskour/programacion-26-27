Algoritmo IntercambiarValores
	
	Definir a como entero;
	Definir b Como Entero;
	Definir c como Entero;
	
	
	Escribir "¿Cuanto vale A?";
	Leer a;
	
	Escribir "¿Cuanto vale B?";
	Leer b;
	
	c <- a;
    a <- b;
    b <- c;
	
	Escribir "Ahora A vale: " a;
    Escribir "Ahora B vale: " b;
	
FinAlgoritmo
